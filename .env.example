# Postgres (Neon / Vercel Postgres / Supabase). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:pass@host:5432/sitio

# Phone notices (Web Push, design §23). Generate the pair once with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact for the push services: a mailto: or https: URL of the group.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Protects /api/cron/notify (the GitHub workflow sends it). openssl rand -base64 32
CRON_SECRET=
