# Postgres (Neon / Vercel Postgres / Supabase). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:pass@host:5432/sitio

# Public URL used in magic-link e-mails (optional; defaults to the request host).
APP_URL=https://seu-sitio.vercel.app

# E-mail via Resend (optional in dev: without it the link is printed in the
# server console and shown on the login page).
RESEND_API_KEY=
EMAIL_FROM="Sítio <sitio@seudominio.com>"
